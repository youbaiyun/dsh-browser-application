{
  "name": "dsh-browser-extension",
  "description": "Chrome and Firefox MV3 extension: the dsh desktop app's browser executor, with a side-panel conversation and text-only read/operate of a user-controlled tab through the dsh browser bridge",
  "version": "0.3.0",
  "author": "youbaiyun",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:firefox": "node scripts/build.mjs --firefox",
    "dev": "node scripts/build.mjs --watch",
    "dev:firefox": "node scripts/build.mjs --firefox --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:layout": "node ../../scripts/measure-panel-layout.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "marked": "^18.0.14"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@yuxianglin/dsh-bridge-browser": "workspace:^",
    "jsdom": "^26.1.0",
    "typescript": "^5.6.2",
    "vite": "^6.0.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  }
}
